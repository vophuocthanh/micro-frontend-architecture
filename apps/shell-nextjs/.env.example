# Server-side only — deliberately NOT prefixed with NEXT_PUBLIC_.
#
# Next.js inlines NEXT_PUBLIC_* variables into the client bundle at build time.
# Using them here would silently turn the remote registry into a build-time
# constant, and repointing a route at a different build would need a full shell
# rebuild — defeating the reason to load remotes at runtime at all.
#
# These are read per request by the root layout and handed to the browser as
# props, so changing one and restarting the shell is enough.

# The API the shell and every remote talk to.
API_BASE_URL=http://localhost:4000

# Origins the shell may load remote JavaScript from. Kept separate from the URLs
# below because it drives the Content-Security-Policy, which is applied at the
# server level rather than per request.
REMOTE_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Where each remote's container lives. Changing one of these repoints a route at
# a different build — a config change and a restart, not a shell rebuild.
DASHBOARD_REMOTE_ENTRY=http://localhost:3001/remoteEntry.js
ACCOUNT_REMOTE_ENTRY=http://localhost:3002/remoteEntry.js
TRANSFER_REMOTE_ENTRY=http://localhost:3003/remoteEntry.js

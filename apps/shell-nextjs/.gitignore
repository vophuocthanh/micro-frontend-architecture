# Next.js
/.next/
/out/
# Generated by Next.js on every build and never hand-edited.
next-env.d.ts

# Environment — real values never leave your machine.
# The shell's variables carry no NEXT_PUBLIC_ prefix on purpose (see ADR-001),
# which also means they are server-side only and must not be committed.
.env
.env.*
!.env.example


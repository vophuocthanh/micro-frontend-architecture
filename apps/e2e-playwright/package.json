{
  "name": "@banking/e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright tests that exercise the composed platform \u2014 the only place all five applications are verified together.",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",

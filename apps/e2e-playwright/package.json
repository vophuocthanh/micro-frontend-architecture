    "clean": "rm -rf test-results playwright-report"
  },
  "devDependencies": {
    "@banking/config": "workspace:*",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.1"
  }
}

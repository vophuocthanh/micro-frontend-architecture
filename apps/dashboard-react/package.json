{
  "name": "@banking/dashboard-react",
  "version": "1.0.0",
  "private": true,
  "description": "React micro frontend owning the Dashboard domain.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001 --strictPort",
    "build": "tsc -b && vite build",
    "start": "vite preview --port 3001 --strictPort",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@banking/contracts": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@banking/config": "workspace:*",
    "@module-federation/vite": "^1.7.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@banking/account-vue",
  "version": "1.0.0",
  "private": true,
  "description": "Vue micro frontend owning the Account domain.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002 --strictPort",
    "build": "vue-tsc -b && vite build && node scripts/verify-remote-entry.mjs",
    "start": "vite preview --port 3002 --strictPort",
    "lint": "eslint src",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@banking/contracts": "workspace:*",
    "@tanstack/vue-query": "^5.62.11",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@banking/config": "workspace:*",
    "@module-federation/vite": "^1.7.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}

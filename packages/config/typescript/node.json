{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node service (NestJS)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "declaration": false
  }
}
